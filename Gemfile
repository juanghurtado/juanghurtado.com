source "https://rubygems.org"

# Jekyll 4 para desarrollo local y para el build de GitHub Actions.
# GitHub Pages sirve el resultado estático de la rama gh-pages.
gem "jekyll", "~> 4.4"

# Plugins que usa el sitio.
gem "jekyll-feed", "~> 0.17"
gem "jekyll-sitemap", "~> 1.4"

# Necesario para `jekyll serve` en Ruby 3+.
gem "webrick", "~> 1.9"
